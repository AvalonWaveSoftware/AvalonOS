#!/usr/bin/python3
"""niri helpers: i3-style stacking (tabbed: one window visible)."""
import json
import subprocess
import sys

LIMIT = 64


def niri_json(*args):
    r = subprocess.run(
        ["niri", "msg", "--json", *args],
        capture_output=True,
        text=True,
        check=True,
    )
    return json.loads(r.stdout) if r.stdout.strip() else None


def niri_action(*args):
    subprocess.run(["niri", "msg", "action", *args], check=True)


def set_display(mode):
    niri_action("set-column-display", mode)


def tiled(ws):
    out = []
    for w in niri_json("windows") or []:
        if w.get("workspace_id") != ws or w.get("is_floating"):
            continue
        pos = (w.get("layout") or {}).get("pos_in_scrolling_layout")
        if pos:
            out.append(w)
    return out


def columns(wins):
    return {w["layout"]["pos_in_scrolling_layout"][0] for w in wins}


def consume(mode="tabbed"):
    focused = niri_json("focused-window")
    if not focused or focused.get("is_floating"):
        return
    niri_action("consume-window-into-column")
    set_display(mode)


def consume_all(mode="tabbed"):
    focused = niri_json("focused-window")
    if not focused or focused.get("is_floating"):
        return
    ws = focused["workspace_id"]
    niri_action("move-column-to-first")
    for _ in range(LIMIT):
        if len(columns(tiled(ws))) <= 1:
            break
        niri_action("consume-window-into-column")
    set_display(mode)


def consume_column():
    consume("normal")


def consume_all_column():
    consume_all("normal")


def expel_all():
    focused = niri_json("focused-window")
    if not focused or focused.get("is_floating"):
        return
    ws = focused["workspace_id"]
    pos = (focused.get("layout") or {}).get("pos_in_scrolling_layout")
    if not pos:
        return
    col = pos[0]
    for _ in range(LIMIT):
        in_col = [
            w
            for w in tiled(ws)
            if w["layout"]["pos_in_scrolling_layout"][0] == col
        ]
        if len(in_col) <= 1:
            return
        niri_action("expel-window-from-column")
        focused = niri_json("focused-window")
        if not focused or focused.get("is_floating"):
            return
        ws = focused["workspace_id"]
        pos = (focused.get("layout") or {}).get("pos_in_scrolling_layout")
        if not pos:
            return
        col = pos[0]


def main():
    cmds = {
        "consume": consume,
        "consume-all": consume_all,
        "consume-column": consume_column,
        "consume-all-column": consume_all_column,
        "expel-all": expel_all,
    }
    if len(sys.argv) != 2 or sys.argv[1] not in cmds:
        print(
            "usage: niri-stack consume|consume-all|consume-column|consume-all-column|expel-all",
            file=sys.stderr,
        )
        return 2
    cmds[sys.argv[1]]()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
