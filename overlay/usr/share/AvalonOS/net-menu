            return
        self._busy = True
        self.set_status(self.vpn_status, "loading…")

        def work():
            return list_libreswan_profiles(), active_vpn_uuids()

        def done(result, err):
            self._busy = False
            if err is not None:
                self.set_status(self.vpn_status, "could not list VPNs", error=True)
                return
            rows, active = result
            self._fill_vpns(rows, active)

        in_thread(work, done)

    def _fill_vpns(self, rows: list[dict], active: set[str]):
        for child in list(self.vpn_box.get_children()):
            self.vpn_box.remove(child)
        labels = {"psk": "PSK", "certificate": "cert", "eap": EAP_USERNAME_PASSWORD_UNSUPPORTED}
        if self._vpn_selected and self._vpn_selected not in {r["uuid"] for r in rows}:
            self._vpn_selected = None
        for row in rows:
            btn = Gtk.Button()
            btn.get_style_context().add_class("ap")
            box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            name = Gtk.Label(label=row["name"])
            name.set_xalign(0)
            name.set_ellipsize(Pango.EllipsizeMode.END)
            name.get_style_context().add_class("ssid")
            on = row["uuid"] in active
            if on:
                name.get_style_context().add_class("on")
            if row["uuid"] == self._vpn_selected:
                name.get_style_context().add_class("on")
            meta_bits = [labels.get(row["kind"], row["kind"])]
            if on:
                meta_bits.append("on")
            meta = Gtk.Label(label="  ".join(meta_bits))
            meta.set_xalign(1)
            meta.get_style_context().add_class("dim")
            box.pack_start(name, True, True, 0)
            box.pack_start(meta, False, False, 0)
            btn.add(box)
            btn.connect("clicked", lambda _w, u=row["uuid"]: self._select_vpn(u))
            self.vpn_box.pack_start(btn, False, False, 0)
        self.vpn_box.show_all()
        n = len(rows)
        if n == 0:
            self.set_status(self.vpn_status, "no IPsec VPNs")
        else:
            self.set_status(self.vpn_status, f"{n} IPsec VPN{'s' if n != 1 else ''}")

    def _select_vpn(self, uuid_value: str):
        self._vpn_selected = uuid_value
        self.refresh_vpn()

    def connect_selected_vpn(self):
        if self._busy:
            return
        uuid_value = self._vpn_selected
        if not uuid_value:
            self.set_status(self.vpn_status, "select a VPN first", error=True)
            return

        def work():
            rows = {r["uuid"]: r for r in list_libreswan_profiles()}
            return rows.get(uuid_value)

        def done(row, err):
            if err is not None or row is None:
                self._busy = False
                self.set_status(self.vpn_status, "select a VPN first", error=True)
                return
            kind = row["kind"]
            if kind == "eap":
                self._busy = False
                self.set_status(self.vpn_status, EAP_USERNAME_PASSWORD_UNSUPPORTED, error=True)
                return
            if kind == "certificate":
                self._connect_existing_vpn(uuid_value)
                return
            self._busy = False
            self._pass_mode = "vpn-psk" if kind == "psk" else "vpn-eap"
            self._pass_vpn_uuid = uuid_value
            self._pass_ssid = ""
            self.pass_title.set_text(row["name"])
            self.pw_entry.set_text("")
            self.set_status(
                self.pass_status,
                "pre-shared key required" if kind == "psk" else "password required",
            )
            self.stack.set_visible_child_name("pass")
            self.pw_entry.grab_focus()

        self._busy = True
        in_thread(work, done)

    def _connect_existing_vpn(self, uuid_value: str, psk=None, password=None):
        if self._busy:
            return
        if not uuid_value:
            return
        self._busy = True
        page = self.stack.get_visible_child_name()
        if page == "pass":
            self.set_status(self.pass_status, "connecting…")
        else:
            self.set_status(self.vpn_status, "connecting…")

        def work():
            return connect_libreswan(uuid_value, psk=psk, password=password)

        def done(result, err):
            self._busy = False
            if err is not None:
                self._fail_vpn("could not connect")
                return
            ok, msg = result
            if ok:
                Gtk.main_quit()
                return
            self._fail_vpn(msg)

        in_thread(work, done)

    def _fail_vpn(self, msg: str):
        if self.stack.get_visible_child_name() == "pass":
            self.set_status(self.pass_status, msg, error=True)
        elif self.stack.get_visible_child_name() == "vpncfg":
            self.set_status(self.vpn_cfg_status, msg, error=True)
        else:
            self.set_status(self.vpn_status, msg, error=True)

    def disconnect_selected_vpn(self):
        if self._busy:
            return
        uuid_value = self._vpn_selected
        self._busy = True
        self.set_status(self.vpn_status, "disconnecting…")

        def work():
            target = uuid_value
            if not target:
                active = active_vpn_uuids()
                for row in list_libreswan_profiles():
                    if row["uuid"] in active:
                        target = row["uuid"]
                        break
            if not target:
                return False, "no VPN selected"
            return disconnect_libreswan(target)

        def done(result, err):
            self._busy = False
            if err is not None:
                self.set_status(self.vpn_status, "could not disconnect", error=True)
                return
            ok, msg = result
            if ok:
                self.refresh_vpn()
                return
            self.set_status(self.vpn_status, msg, error=True)

        in_thread(work, done)

    def submit_vpn_cfg(self):
        if self._busy:
            return
        kind = self.vpn_auth.get_active_id() or "psk"
        if kind == "eap":
            self.set_status(self.vpn_cfg_status, EAP_USERNAME_PASSWORD_UNSUPPORTED, error=True)
            return
        name = self.vpn_name.get_text().strip()
        gateway = self.vpn_gateway.get_text().strip()
        username = self.vpn_user.get_text().strip()
        cert = self.vpn_cert.get_text().strip()
        psk = self.vpn_psk.get_text() if kind == "psk" else None
        password = self.vpn_eap_pw.get_text() if kind == "eap" else None
        self._busy = True
        status = "connecting…"
        if kind == "psk" and psk:
            warn = vpn_psk_strength_warning(psk)
            if warn:
                status = "connecting… (" + warn + ")"
        self.set_status(self.vpn_cfg_status, status)

        def work():
            return configure_and_connect_libreswan(
                name,
                gateway,
                kind,
                username=username,
                cert=cert,
                psk=psk,
                password=password,
            )

        def done(result, err):
            self._busy = False
            if err is not None:
                self.set_status(self.vpn_cfg_status, "could not connect", error=True)
                return
            ok, msg = result
            if ok:
                Gtk.main_quit()
                return
            self.set_status(self.vpn_cfg_status, msg, error=True)

        in_thread(work, done)

    def edit(self):
        spawn("nm-connection-editor")
        Gtk.main_quit()

    def bluetooth(self):
        spawn("blueman-manager")
        Gtk.main_quit()

    def copy_ip(self):
        ip = ipv4()
        if ip and shutil.which("wl-copy"):
            subprocess.run(["wl-copy"], input=ip, text=True, check=False)
        Gtk.main_quit()

    def nmtui(self):
        spawn("avalonos-alacritty", "--class", "AvalonOS-nmtui", "-e", "nmtui")
        Gtk.main_quit()

    def disconnect(self):
        out = run("nmcli", "-t", "-f", "DEVICE,TYPE,STATE", "device", capture=True)
        for line in out.splitlines():
            parts = nmcli_fields(line)
            dev, typ, state = (parts + ["", "", ""])[:3]
            if state == "connected" and typ in ("wifi", "ethernet"):
                run("nmcli", "device", "disconnect", dev)
                break
        Gtk.main_quit()


def main():
    PIDFILE = runtime_dir() / "avalonos-net.pid"
    if already_running():
        sys.exit(0)
    _clear_stale_nm_tempfiles()
    GLib.set_prgname(APP_ID)
    PIDFILE.write_text(str(os.getpid()))
    css = Gtk.CssProvider()
    css.load_from_data(CSS.encode())
    screen = Gdk.Screen.get_default()
    if screen is not None:
        Gtk.StyleContext.add_provider_for_screen(
            screen,
            css,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
        )
    win = NetWin()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    try:
        Gtk.main()
    finally:
        PIDFILE.unlink(missing_ok=True)


if __name__ == "__main__":
    main()
