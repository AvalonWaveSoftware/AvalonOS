def _vpn_data_ok(value: str) -> bool:
    # Values land in vpn.data as comma-separated key=value. P-I29: reject
    # all C0 controls, DEL, separators, backslash and quotes.
    if not value:
        return False
    for c in value:
        o = ord(c)
        if o < 0x20 or o == 0x7F or c in ",=\\'\"":
            return False
    return True


def _vpn_gateway_ok(value: str) -> bool:
    return _vpn_data_ok(value) and all(c.isalnum() or c in "._-:[]" for c in value)


def vpn_psk_strength_warning(psk: str) -> str:
    # P-I26: the gateway dictates the PSK; warn, do not reject, when short.
    if psk and len(psk) < 20:
        return "pre-shared key is under 20 characters"
    return ""


def _vpn_secret_ok(value: str) -> bool:
    return bool(value) and all(c not in value for c in "\n\r\x00")


def parse_vpn_data(raw: str) -> dict[str, str]:
    out: dict[str, str] = {}
    if not raw:
        return out
    for part in raw.split(","):
        if "=" not in part:
            continue
        key, _, val = part.partition("=")
        key, val = key.strip(), val.strip()
        if key:
            out[key] = val
    return out


def vpn_auth_kind(data: dict[str, str]) -> str:
    if data.get("leftcert"):
        return "certificate"
    if data.get("leftusername") or data.get("leftxauthusername"):
        return "eap"
    return "psk"


def list_libreswan_profiles() -> list[dict]:
    out = run("nmcli", "-t", "-f", "UUID,TYPE,NAME", "connection", "show", capture=True) or ""
    rows: list[dict] = []
    for line in out.splitlines():
        parts = nmcli_fields(line)
        if len(parts) < 3:
            continue
        uuid_value, typ, name = parts[0], parts[1], parts[2]
        if typ != "vpn":
            continue
        svc = (
            run(
                "nmcli",
                "-e",
                "no",
                "-g",
                "vpn.service-type",
                "connection",
                "show",
                "uuid",
                uuid_value,
                capture=True,
            )
            or ""
        )
        if svc.strip() != LIBRESWAN_SERVICE:
            continue
        data_raw = (
            run(
                "nmcli",
                "-e",
                "no",
                "-g",
                "vpn.data",
                "connection",
                "show",
                "uuid",
                uuid_value,
                capture=True,
            )
            or ""
        )
        data = parse_vpn_data(data_raw)
        rows.append(
            {
                "uuid": uuid_value,
                "name": name,
                "data": data,
                "kind": vpn_auth_kind(data),
            }
        )
    return rows


def active_vpn_uuids() -> set[str]:
    out = (
        run(
            "nmcli",
            "-t",
            "-f",
            "UUID,TYPE",
            "connection",
            "show",
            "--active",
            capture=True,
        )
        or ""
    )
    found: set[str] = set()
    for line in out.splitlines():
        parts = nmcli_fields(line)
        if len(parts) >= 2 and parts[1] == "vpn":
            found.add(parts[0])
    return found


def add_libreswan_connection(
    name: str,
    gateway: str,
    kind: str,
    *,
    username: str = "",
    cert: str = "",
) -> tuple[str | None, str]:
    if kind == "eap":
        return None, EAP_USERNAME_PASSWORD_UNSUPPORTED
    if not _vpn_data_ok(name) or not _vpn_gateway_ok(gateway):
        return None, "invalid name or gateway"
    if kind not in ("psk", "certificate"):
        return None, "unsupported authentication type"
    # IPsec road-warrior (R5-M3): when leftsubnet is omitted, libreswan
    # defaults TSi to left (the physical host address, e.g. 10.0.2.15/32).
    # A pool gateway assigns a VIP via IKEv2 CP but then rejects that TSi
    # with TS_UNACCEPTABLE. leftmodecfgclient=yes + narrowing=yes is not
    # enough by itself. Propose leftsubnet=0.0.0.0/0 so TSi covers the
    # assigned VIP; the gateway may narrow it (P-I38: no full-tunnel /
    # kill-switch guarantee). ikev2=insist stays; leftid is only set for
    # certificate auth (IKEv1 + leftid would force aggressive mode).
    # R5-V3a: rightca=%same on certificate auth so the client sends
    # CERTREQ (needed when the responder uses send_cert=ifasked).
    parts = [
        f"right={gateway}",
        "ikev2=insist",
        "leftmodecfgclient=yes",
        "narrowing=yes",
        "leftsubnet=0.0.0.0/0",
    ]
    if kind == "psk":
        parts += ["authby=secret", "pskvalue-flags=2"]
    elif kind == "certificate":
        if not _vpn_data_ok(cert):
            return None, "invalid certificate nickname"
        parts += [f"leftcert={cert}", "leftid=%fromcert", "rightca=%same"]
    else:
        if not _vpn_data_ok(username):
            return None, "invalid username"
        parts += [
            f"leftusername={username}",
            f"leftxauthusername={username}",
            "xauthpassword-flags=2",
        ]
    created_uuid = str(uuid.uuid4())
    add = subprocess.run(
        [
            "nmcli",
            "connection",
            "add",
            "type",
            "vpn",
            "vpn-type",
            "libreswan",
            "con-name",
            name,
            "connection.uuid",
            created_uuid,
            "vpn.data",
            ",".join(parts),
            "connection.autoconnect",
            "no",
        ],
        capture_output=True,
        text=True,
        timeout=30,
    )
    if add.returncode != 0:
        return None, (add.stderr or add.stdout or "could not create connection").strip() or "could not create connection"
    remember_menu_profile(created_uuid)
    return created_uuid, ""


def _nmcli_up_passwd_file(uuid_value: str, secret_lines: list[str]) -> tuple[bool, str]:
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    if not runtime:
        return False, "XDG_RUNTIME_DIR is not set"
    fd_open = True
    r = None
    fd, passwd_path = tempfile.mkstemp(prefix="avalonos-nm-", dir=runtime, text=True)
    try:
        payload = "".join(
            line if line.endswith("\n") else line + "\n" for line in secret_lines
        )
        os.write(fd, payload.encode())
        os.close(fd)
        fd_open = False
        os.chmod(passwd_path, 0o600)
        r = subprocess.run(
            [
                "nmcli",
                "-w",
                "25",
                "connection",
                "up",
                "uuid",
                uuid_value,
                "passwd-file",
                passwd_path,
            ],
            capture_output=True,
            text=True,
            timeout=30,
        )
    finally:
        if fd_open:
            try:
                os.close(fd)
            except OSError:
                pass
        try:
            os.unlink(passwd_path)
        except OSError:
            pass
    if r is None:
        return False, "could not connect"
    err = (r.stderr or r.stdout or "").strip()
    if r.returncode == 0:
        return True, ""
    return False, err or "could not connect"


def connect_libreswan(
    uuid_value: str,
    *,
    psk: str | None = None,
    password: str | None = None,
) -> tuple[bool, str]:
    if psk is not None:
        if not _vpn_secret_ok(psk):
            return False, "invalid secret"
        return _nmcli_up_passwd_file(uuid_value, [f"vpn.secrets.pskvalue:{psk}"])
    if password is not None:
        # Existing EAP username/password profiles cannot be brought up
        # (same unsupported method; do not prompt or place a secret).
        return False, EAP_USERNAME_PASSWORD_UNSUPPORTED
    r = subprocess.run(
        ["nmcli", "-w", "25", "connection", "up", "uuid", uuid_value],
        capture_output=True,
        text=True,
        timeout=30,
    )
    err = (r.stderr or r.stdout or "").strip()
    if r.returncode == 0:
        return True, ""
    return False, err or "could not connect"


def disconnect_libreswan(uuid_value: str) -> tuple[bool, str]:
    r = subprocess.run(
        ["nmcli", "connection", "down", "uuid", uuid_value],
        capture_output=True,
        text=True,
        timeout=30,
    )
    if r.returncode == 0:
        return True, ""
    return False, (r.stderr or r.stdout or "could not disconnect").strip() or "could not disconnect"


def configure_and_connect_libreswan(
    name: str,
    gateway: str,
    kind: str,
    *,
    username: str = "",
    cert: str = "",
    psk: str | None = None,
    password: str | None = None,
) -> tuple[bool, str]:
    if kind == "eap":
        return False, EAP_USERNAME_PASSWORD_UNSUPPORTED
    if kind == "psk":
        if psk is None or not _vpn_secret_ok(psk):
            return False, "invalid secret"
    created_uuid, err = add_libreswan_connection(
        name, gateway, kind, username=username, cert=cert
    )
    if not created_uuid:
        return False, err
    try:
        if kind == "psk":
            ok, msg = connect_libreswan(created_uuid, psk=psk)
        elif kind == "eap":
            ok, msg = connect_libreswan(created_uuid, password=password)
        else:
            ok, msg = connect_libreswan(created_uuid)
    except Exception:
        delete_connection(created_uuid)
        raise
    if not ok:
        delete_connection(created_uuid)
        return False, msg
    return True, ""


def in_thread(work, done):
    def wrap():
        try:
            result = work()
            err = None
        except Exception as exc:  # noqa: BLE001 — surface to UI
            result, err = None, exc
        GLib.idle_add(lambda: (done(result, err), False)[1])

    threading.Thread(target=wrap, daemon=True).start()


