    def scan_wifi(self):
        if self._busy:
            return
        if not wifi_device():
            self.set_status(self.wifi_status, "no wifi adapter", error=True)
            self._fill_aps([])
            return
        self._busy = True
        self.set_status(self.wifi_status, "scanning…")
        self._fill_aps([])

        def work():
            if not wifi_on():
                run("nmcli", "radio", "wifi", "on")
            aps = list_aps()
            if not aps:
                aps = list_aps()
            return aps

        def done(aps, err):
            self._busy = False
            if err is not None:
                self.set_status(self.wifi_status, str(err), error=True)
                return
            n = len(aps or [])
            if n == 0:
                self.set_status(self.wifi_status, "no networks found")
            else:
                self.set_status(self.wifi_status, f"{n} network{'s' if n != 1 else ''}")
            self._fill_aps(aps or [])

        in_thread(work, done)

    def _fill_aps(self, aps: list[dict]):
        for child in list(self.ap_box.get_children()):
            self.ap_box.remove(child)
        for ap in aps:
            self.ap_box.pack_start(self._ap_button(ap), False, False, 0)
        self.ap_box.show_all()

    def _ap_button(self, ap: dict) -> Gtk.Button:
        btn = Gtk.Button()
        btn.get_style_context().add_class("ap")
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        name = Gtk.Label(label=ap["ssid"])
        name.set_xalign(0)
        name.set_ellipsize(Pango.EllipsizeMode.END)
        name.get_style_context().add_class("ssid")
        if ap["in_use"]:
            name.get_style_context().add_class("on")
        meta_bits = [f"{ap['signal']}%"]
        if not ap["open"]:
            meta_bits.append("lock")
        if ap["in_use"]:
            meta_bits.append("on")
        meta = Gtk.Label(label="  ".join(meta_bits))
        meta.set_xalign(1)
        meta.get_style_context().add_class("dim")
        row.pack_start(name, True, True, 0)
        row.pack_start(meta, False, False, 0)
        btn.add(row)
        btn.connect("clicked", lambda _w, a=ap: self.pick_ap(a))
        return btn

    def pick_ap(self, ap: dict):
        if self._busy:
            return
        if ap["in_use"]:
            self.set_status(self.wifi_status, f"already on {ap['ssid']}")
            return
        if ap["open"] or ap["ssid"] in saved_wifi():
            self._connect(ap["ssid"], None)
            return
        self._show_password(ap["ssid"])

    def _show_password(self, ssid: str, err: str = ""):
        self._pass_ssid = ssid
        self.pass_title.set_text(ssid)
        self.pw_entry.set_text("")
        self.set_status(self.pass_status, err or "password required", error=bool(err))
        self.stack.set_visible_child_name("pass")
        self.pw_entry.grab_focus()

    def _pass_back(self):
        if self._pass_mode in ("vpn-psk", "vpn-eap"):
            self.stack.set_visible_child_name("vpn")
            self.resize(*VPN_SIZE)
            return
        self.stack.set_visible_child_name("wifi")

    def submit_password(self):
        pw = self.pw_entry.get_text()
        if not pw:
            self.set_status(self.pass_status, "password required", error=True)
            return
        if self._pass_mode == "vpn-psk":
            self._connect_existing_vpn(self._pass_vpn_uuid, psk=pw)
            return
        if self._pass_mode == "vpn-eap":
            self._connect_existing_vpn(self._pass_vpn_uuid, password=pw)
            return
        ssid = self._pass_ssid
        if not ssid:
            return
        self._connect(ssid, pw)

    def _connect(self, ssid: str, password: str | None):
        if self._busy:
            return
        self._busy = True
        page = self.stack.get_visible_child_name()
        if page == "pass":
            self.set_status(self.pass_status, "connecting…")
        else:
            self.set_status(self.wifi_status, f"connecting to {ssid}…")

        def work():
            return connect_wifi(ssid, password)

        def done(result, err):
            self._busy = False
            if err is not None:
                self._fail_connect(ssid, str(err), password)
                return
            ok, msg = result
            if ok:
                Gtk.main_quit()
                return
            self._fail_connect(ssid, msg, password)

        in_thread(work, done)

    def _fail_connect(self, ssid: str, msg: str, password: str | None):
        if password is None and needs_secrets(msg):
            self._show_password(ssid, "password required")
            return
        if self.stack.get_visible_child_name() == "pass":
            self.set_status(self.pass_status, msg, error=True)
        else:
            self.set_status(self.wifi_status, msg, error=True)


