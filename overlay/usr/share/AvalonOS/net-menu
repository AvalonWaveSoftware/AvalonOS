def already_running() -> bool:
    PIDFILE = runtime_dir() / "avalonos-net.pid"
    if not PIDFILE.exists():
        return False
    try:
        pid = int(PIDFILE.read_text().strip())
        os.kill(pid, 0)
        os.kill(pid, signal.SIGTERM)
        PIDFILE.unlink(missing_ok=True)
        return True
    except (ValueError, ProcessLookupError, PermissionError, OSError):
        PIDFILE.unlink(missing_ok=True)
        return False


def run(*cmd, capture=False, timeout=30):
    try:
        r = subprocess.run(
            cmd,
            check=False,
            capture_output=True,
            text=True,
            timeout=timeout,
        )
        if capture:
            return (r.stdout or "").strip()
        return r.returncode
    except FileNotFoundError:
        return "" if capture else 1
    except subprocess.TimeoutExpired:
        return "" if capture else 1


def nmcli_fields(line: str) -> list[str]:
    parts: list[str] = []
    buf: list[str] = []
    esc = False
    for ch in line:
        if esc:
            buf.append(ch)
            esc = False
        elif ch == "\\":
            esc = True
        elif ch == ":":
            parts.append("".join(buf))
            buf = []
        else:
            buf.append(ch)
    parts.append("".join(buf))
    return parts


def wifi_on() -> bool:
    return run("nmcli", "-t", "radio", "wifi", capture=True) == "enabled"


def wifi_device() -> str:
    out = run("nmcli", "-t", "-f", "DEVICE,TYPE,STATE", "device", "status", capture=True)
    for line in out.splitlines():
        parts = nmcli_fields(line)
        if len(parts) >= 2 and parts[1] == "wifi":
            return parts[0]
    return ""


def ipv4() -> str:
    out = run("nmcli", "-t", "-f", "IP4.ADDRESS", "device", "show", capture=True)
    for line in out.splitlines():
        if line.startswith("IP4.ADDRESS") and "/" in line:
            return line.split(":", 1)[-1].split("/")[0]
    return ""


def spawn(*cmd):
    subprocess.Popen(cmd, start_new_session=True)


def saved_wifi() -> set[str]:
    out = run("nmcli", "-t", "-f", "NAME,TYPE", "connection", "show", capture=True)
    names: set[str] = set()
    for line in out.splitlines():
        parts = nmcli_fields(line)
        if len(parts) >= 2 and parts[1] == "802-11-wireless":
            names.add(parts[0])
    return names


def wifi_profile_ssid(uuid_value: str) -> str:
    # QA-L2: Fedora 44 nmcli 1.56.1 rejects a setting field in list mode
    # (`-f …,802-11-wireless.ssid connection show`, rc=2). Query the SSID
    # of one profile with `-g` instead.
    # M-1 / P-I30: nmcli -g escapes ":" and "\\" unless -e no is set.
    return run(
        "nmcli", "-e", "no", "-g", "802-11-wireless.ssid",
        "connection", "show", "uuid", uuid_value, capture=True,
    )


def wifi_uuids_for_ssid(ssid: str) -> list[str]:
    # P-L20 / QA-L2: match profiles by the Wi-Fi SSID, not by connection name.
    # List UUID,TYPE only, then read each Wi-Fi profile's SSID per UUID.
    out = run(
        "nmcli", "-t", "-f", "UUID,TYPE", "connection", "show", capture=True,
    )
    uuids: list[str] = []
    for line in out.splitlines():
        parts = nmcli_fields(line)
        if len(parts) >= 2 and parts[1] == "802-11-wireless":
            if wifi_profile_ssid(parts[0]) == ssid:
                uuids.append(parts[0])
    return uuids


def _state_dir() -> Path | None:
    root = os.environ.get("XDG_STATE_HOME")
    if root:
        return Path(root) / "avalonos"
    home = os.environ.get("HOME")
    if home:
        return Path(home) / ".local/state/avalonos"
    return None


def _registry_path() -> Path | None:
    d = _state_dir()
    return None if d is None else d / "net-menu.uuids"


_UUID_RE = re.compile(
    r"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
)


def _valid_uuid(value: str) -> bool:
    return bool(value) and bool(_UUID_RE.fullmatch(value))


def _read_registry_lines(path: Path) -> set[str]:
    # P-I25: do not follow a symlink; tolerate invalid UTF-8; keep only UUIDs.
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
    try:
        fd = os.open(path, flags)
    except OSError:
        return set()
    try:
        data = os.read(fd, 1 << 20)
    finally:
        os.close(fd)
    text = data.decode("utf-8", errors="replace")
    return {ln.strip() for ln in text.splitlines() if _valid_uuid(ln.strip())}


def _write_registry(path: Path, uuids: set[str]) -> None:
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    if path.is_symlink():
        return
    clean = sorted(u for u in uuids if _valid_uuid(u))
    if not clean:
        try:
            path.unlink()
        except OSError:
            pass
        return
    fd, tmp = tempfile.mkstemp(prefix="net-menu.uuids.", dir=str(path.parent), text=True)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write("".join(u + "\n" for u in clean))
            fh.flush()
            os.fsync(fh.fileno())
        os.chmod(tmp, 0o600)
        os.replace(tmp, path)
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def remember_menu_profile(uuid_value: str) -> None:
    # P-I24: ownership is the UUIDs this menu created, not a name prefix.
    path = _registry_path()
    if path is None or not _valid_uuid(uuid_value):
        return
    try:
        existing = _read_registry_lines(path) if path.exists() and not path.is_symlink() else set()
        existing.add(uuid_value)
        _write_registry(path, existing)
    except OSError:
        pass


def menu_profile_uuids() -> set[str]:
    path = _registry_path()
    if path is None or not path.exists():
        return set()
    try:
        return _read_registry_lines(path)
    except OSError:
        return set()


def forget_menu_profile(uuid_value: str) -> None:
    path = _registry_path()
    if path is None or not uuid_value:
        return
    try:
        existing = menu_profile_uuids()
        existing.discard(uuid_value)
        _write_registry(path, existing)
    except OSError:
        pass


def iwd_ssid_config_stem(ssid: str) -> str:
    # iwd.network(5): verbatim if only alnum, space, underscore or minus;
    # otherwise "=" + lowercase hex of the UTF-8 SSID.
    if ssid and all(ch.isalnum() or ch in " _-" for ch in ssid):
        return ssid
    return "=" + ssid.encode("utf-8").hex()


# iwd stores one file per (SSID, security type). A bare `iwctl
# known-networks <ssid> forget` is ambiguous when both .psk and .open
# (or .8021x) exist (M-2 / W4).
IWD_KNOWN_TYPES = ("psk", "open", "8021x")


_IWD_LIST_ANSI = re.compile(r"\x1b\[[0-9;]*[A-Za-z]")


def iwd_service_is_active() -> bool:
    # P-L31: a zero exit from `iwctl known-networks list` is not proof
    # that iwd is up. Require systemctl to report the unit active.
    try:
        result = subprocess.run(
            ["systemctl", "is-active", "iwd"],
            capture_output=True, text=True, timeout=30,
        )
    except (OSError, subprocess.TimeoutExpired):
        return False
    return result.returncode == 0 and (result.stdout or "").strip() == "active"


def split_iwd_qualified_name(name: str) -> tuple[str, str] | None:
    for typ in IWD_KNOWN_TYPES:
        suffix = "." + typ
        if name.endswith(suffix) and len(name) > len(suffix):
            return name[: -len(suffix)], typ
    return None


def known_network_in_iwctl_list(text: str, name: str) -> bool:
    # Parse `iwctl known-networks list` output (optional ANSI). The
    # qualified name is ssid.psk / ssid.open / ssid.8021x. A substring
    # hit on a longer SSID does not count.
    parts = split_iwd_qualified_name(name)
    if not parts:
        return False
    ssid, typ = parts
    body = _IWD_LIST_ANSI.sub("", text or "")
    for raw in body.splitlines():
        line = raw.strip()
        if not line or set(line) <= set("-="):
            continue
        lowered = line.lower()
        if lowered.startswith("known networks") or (
            lowered.startswith("name") and "security" in lowered
        ):
            continue
        tokens = line.split()
        if ssid in tokens and typ in tokens:
            return True
        if line.startswith(ssid + " ") and typ in tokens:
            return True
    return False


def forget_iwd_known_network(ssid: str) -> bool:
    # QA-L3 / M-2: forget every known type for this SSID via iwctl
    # (session D-Bus). Never put a PSK on argv; do not write under
    # /var/lib/iwd. Returns True if every attempt succeeded or the
    # network was already unknown. False on denial, timeout, or an
    # ambiguous/other error — callers must fail closed.
    #
    # P-M30: a single leading `--` stops iwctl's getopt_long ("u:p:P:dh")
    # so a name starting with -h is not treated as help. Do not pass a
    # second `--` after known-networks: iwctl binds that as the entity
    # and the forget never runs. Form: iwctl -- known-networks NAME forget.
    # P-L31: a not-found result is clean only if iwd is active and the
    # parsed list lacks that network.
    if not ssid:
        return False
    def not_found(result):
        text = (result.stderr or result.stdout or "").lower()
        return result.returncode != 0 and any(
            phrase in text for phrase in ("no network", "not found", "does not exist")
        )

    ok = True
    try:
        for typ in IWD_KNOWN_TYPES:
            name = f"{ssid}.{typ}"
            command = ["iwctl", "--", "known-networks", name, "forget"]
            result = subprocess.run(command, capture_output=True, text=True, timeout=30)
            if result.returncode == 0:
                # A zero exit can also be help output; verify the key is gone.
                result = subprocess.run(command, capture_output=True, text=True, timeout=30)
            if not_found(result):
                if iwd_service_is_active():
                    probe = subprocess.run(
                        ["iwctl", "--", "known-networks", "list"],
                        capture_output=True, text=True, timeout=30,
                    )
                    listed = known_network_in_iwctl_list(
                        (probe.stdout or "") + "\n" + (probe.stderr or ""),
                        name,
                    )
                    if probe.returncode == 0 and not listed:
                        continue
            print(
                "avalonos-net-menu: could not clear saved Wi-Fi credentials for this network",
                file=sys.stderr,
            )
            ok = False
    except (OSError, subprocess.TimeoutExpired):
        print(
            "avalonos-net-menu: could not clear saved Wi-Fi credentials for this network",
            file=sys.stderr,
        )
        return False
    return ok


def delete_connection(uuid_value: str) -> None:
    try:
        result = subprocess.run(
            ["nmcli", "connection", "delete", "uuid", uuid_value],
            capture_output=True, text=True, timeout=30,
        )
        if result.returncode != 0:
            print("avalonos-net-menu: connection delete failed", file=sys.stderr)
        else:
            forget_menu_profile(uuid_value)
    except (OSError, subprocess.TimeoutExpired):
        print("avalonos-net-menu: connection delete failed", file=sys.stderr)


def delete_older_menu_profiles(ssid: str, active_uuid: str) -> None:
    # P-I24: delete only profiles this menu recorded, for this SSID, never
    # the active UUID and never a user profile whose name merely starts
    # with avalonos-.
    owned = menu_profile_uuids()
    for uuid_value in wifi_uuids_for_ssid(ssid):
        if uuid_value != active_uuid and uuid_value in owned:
            delete_connection(uuid_value)

def psk_acceptable(password: str) -> bool:
    # P-I19: reject CR/LF/NUL; allow 8-63 ASCII printable or 64 hex.
    if any(ch in password for ch in ("\r", "\n", chr(0))):
        return False
    if len(password) == 64 and all(ch in "0123456789abcdefABCDEF" for ch in password):
        return True
    if 8 <= len(password) <= 63 and all(0x20 <= ord(ch) <= 0x7E for ch in password):
        return True
    return False


def _added_uuid(text: str) -> str | None:
    # nmcli: Connection 'name' (uuid) successfully added.
    if not text:
        return None
    for part in text.replace(")", "(").split("("):
        token = part.strip()
        if len(token) == 36 and token.count("-") == 4:
            return token
    return None


def is_open(security: str) -> bool:
    return security.strip() in ("", "--", "none", "None")


def list_aps() -> list[dict]:
    out = run(
        "nmcli",
        "-t",
        "-f",
        "IN-USE,SSID,SECURITY,SIGNAL",
        "device",
        "wifi",
        "list",
        "--rescan",
        "yes",
        capture=True,
        timeout=20,
    )
    by_ssid: dict[str, dict] = {}
    for line in out.splitlines():
        parts = nmcli_fields(line)
        if len(parts) < 4:
            continue
        in_use, ssid, security, signal = parts[0], parts[1], parts[2], parts[3]
        if not ssid:
            continue
        try:
            sig = int(signal)
        except ValueError:
            sig = 0
        row = {
            "ssid": ssid,
            "security": security,
            "signal": sig,
            "in_use": in_use == "*",
            "open": is_open(security),
        }
        prev = by_ssid.get(ssid)
        if prev is None or row["in_use"] or row["signal"] > prev["signal"]:
            by_ssid[ssid] = row
    aps = list(by_ssid.values())
    aps.sort(key=lambda a: (not a["in_use"], -a["signal"], a["ssid"].lower()))
    return aps


def connect_wifi(ssid: str, password: str | None = None) -> tuple[bool, str]:
    if password is not None and not psk_acceptable(password):
        return False, "invalid password"

    if password is None:
        for saved_uuid in wifi_uuids_for_ssid(ssid):
            r = subprocess.run(
                ["nmcli", "-w", "25", "connection", "up", "uuid", saved_uuid],
                capture_output=True,
                text=True,
                timeout=30,
            )
            if r.returncode == 0:
                return True, ""
        r = subprocess.run(
            ["nmcli", "-w", "25", "device", "wifi", "connect", ssid],
            capture_output=True,
            text=True,
            timeout=30,
        )
        err = (r.stderr or r.stdout or "").strip()
        if r.returncode == 0:
            return True, ""
        return False, err or "could not connect"

    # Password-protected: Fedora 44 nmcli accepts passwd-file only on
    # "connection up", not on "device wifi connect" (R8-B1). Never put the
    # PSK on argv. Open the cleanup try/finally immediately after mkstemp
    # (P-L19) so a write/close/chmod error still removes the 0600 tempfile.
    #
    # P-L20: always add a fresh profile (check the add return code) and
    # activate it by UUID. Do not "connection up" an existing profile that
    # may already hold a stored PSK — a wrong passwd-file would still
    # activate in that case (QA 0.1.0-8 item 5d). Also forget iwd's
    # stored PSK for this SSID before activation (QA-L3).
    # P-I19: delete the profile we created if activation fails.
    # wifi-sec.key-mgmt stays wpa-psk (WPA3-only/SAE, enterprise and WEP
    # are not offered from the menu).
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    if not runtime:
        return False, "XDG_RUNTIME_DIR is not set"
    fd_open = True
    created_uuid = None
    r = None
    fd, passwd_path = tempfile.mkstemp(prefix="avalonos-nm-", dir=runtime, text=True)
    try:
        created_name = f"avalonos-{os.getpid()}-{os.urandom(4).hex()}"
        os.write(fd, f"802-11-wireless-security.psk:{password}\n".encode())
        os.close(fd)
        fd_open = False
        os.chmod(passwd_path, 0o600)
        created_uuid = str(uuid.uuid4())
        add = subprocess.run(
            [
                "nmcli",
                "connection",
                "add",
                "type",
                "wifi",
                "ifname",
                "*",
                "con-name",
                created_name,
                "connection.uuid",
                created_uuid,
                "ssid",
                ssid,
                "wifi-sec.key-mgmt",
                "wpa-psk",
            ],
            capture_output=True,
            text=True,
            timeout=30,
        )
        if add.returncode != 0:
            return False, (add.stderr or add.stdout or "could not create connection").strip() or "could not create connection"
        remember_menu_profile(created_uuid)
        # QA-L3 / M-2: drop iwd's stored credentials for this SSID so a
        # wrong passwd-file cannot authenticate with a previously saved
        # passphrase. Fail closed if forget did not succeed.
        if not forget_iwd_known_network(ssid):
            delete_connection(created_uuid)
            created_uuid = None
            return False, "could not clear saved Wi-Fi credentials for this network"
        r = subprocess.run(
            [
                "nmcli",
                "-w",
                "25",
                "connection",
                "up",
                "uuid",
                created_uuid,
                "passwd-file",
                passwd_path,
            ],
            capture_output=True,
            text=True,
            timeout=30,
        )
    finally:
        if fd_open:
            try:
                os.close(fd)
            except OSError:
                pass
        try:
            os.unlink(passwd_path)
        except OSError:
            pass
        # Timeout or other exception after add: still drop the profile we created.
        if created_uuid and (r is None or r.returncode != 0):
            delete_connection(created_uuid)
    if r is None:
        return False, "could not connect"
    err = (r.stderr or r.stdout or "").strip()
    if r.returncode == 0:
        delete_older_menu_profiles(ssid, created_uuid)
        return True, ""
    return False, err or "could not connect"


def needs_secrets(err: str) -> bool:
    low = err.lower()
    return any(
        s in low
        for s in (
            "secrets",
            "password",
            "802-11-wireless-security",
            "no secrets",
            "authentication",
        )
    )



LIBRESWAN_SERVICE = "org.freedesktop.NetworkManager.libreswan"
# QA H-1: Fedora libreswan implements EAP-TLS only, not EAP-MSCHAPv2.
# The username/password option stays in the menu but is labeled and
# refused as unsupported. Certificate auth (the EAP-TLS path) is unchanged.
