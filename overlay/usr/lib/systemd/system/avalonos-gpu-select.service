[Unit]
Description=AvalonOS: choose hardware GL or Mesa kms_swrast for niri
Documentation=file:///usr/libexec/avalonos/gpu-select
After=systemd-udevd.service systemd-modules-load.service
Before=greetd.service display-manager.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Root-owned output in /run (tmpfs, recreated each boot). niri.service reads
# it via EnvironmentFile; users cannot write it (AOS code-security item 4).
RuntimeDirectory=avalonos
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
UMask=0022
ExecStartPre=-/usr/bin/udevadm settle --timeout=10
ExecStart=/bin/sh -c '/usr/bin/timeout 15 /usr/libexec/avalonos/gpu-select > /run/avalonos/gpu.env.new || : > /run/avalonos/gpu.env.new; mv -f /run/avalonos/gpu.env.new /run/avalonos/gpu.env'

[Install]
WantedBy=graphical.target
