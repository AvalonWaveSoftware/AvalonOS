#!/bin/sh
# AvalonOS session: greetd → niri.service with a working user bus.
set -e
export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-niri}"
export XDG_SESSION_TYPE="${XDG_SESSION_TYPE:-wayland}"

uid="$(id -u)"
if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
    export XDG_RUNTIME_DIR="/run/user/${uid}"
fi
if [ ! -d "$XDG_RUNTIME_DIR" ]; then
    install -d -m 700 "$XDG_RUNTIME_DIR" 2>/dev/null || true
fi
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && [ -S "${XDG_RUNTIME_DIR}/bus" ]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR}/bus"
fi

# greetd already opened a PAM session and set XDG_VTNR/SEAT. A login-shell
# re-exec can drop those and leave niri importing the wrong DRM node.
if [ -z "${XDG_VTNR:-}" ]; then
    if [ -n "$SHELL" ] && grep -qx "$SHELL" /etc/shells \
        && ! echo "$SHELL" | grep -Eq 'false|nologin'; then
        if [ "${1:-}" != "-l" ]; then
            exec "$SHELL" -l -c 'exec "$0" -l "$@"' "$0" "$@"
        fi
        shift
    fi
fi

if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
    export XDG_RUNTIME_DIR="/run/user/${uid}"
fi
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && [ -S "${XDG_RUNTIME_DIR}/bus" ]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR}/bus"
fi

if ! systemctl --user show-environment >/dev/null 2>&1; then
    echo "AvalonOS: no systemd --user bus (XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR)." >&2
    echo "Log in from the greeter on VT1 (Ctrl+Alt+F1), not from a raw TTY/SSH shell." >&2
    exit 1
fi

if systemctl --user -q is-active niri.service; then
    echo 'A niri session is already running.' >&2
    exit 1
fi

systemctl --user reset-failed >/dev/null 2>&1 || true
systemctl --user import-environment \
    XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_SESSION_ID XDG_SEAT XDG_VTNR \
    XDG_RUNTIME_DIR DBUS_SESSION_BUS_ADDRESS HOME USER LOGNAME SHELL PATH \
    >/dev/null 2>&1 || true
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --systemd \
        XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_RUNTIME_DIR XDG_VTNR XDG_SEAT \
        XDG_SESSION_ID DBUS_SESSION_BUS_ADDRESS HOME USER \
        >/dev/null 2>&1 || true
fi

# GPU path (9:41 CT decision): avalonos-gpu-select.service (root, at boot)
# wrote /run/avalonos/gpu.env; niri.service reads it via its drop-in
# 10-avalonos-gpu.conf. Nothing here writes or sources it.
gpu_env=/run/avalonos/gpu.env

# Display-only adapter and no render-capable GPU at all (QEMU -vga std /
# bochs-drm, simpledrm only, hyperv_drm, BMC VGA ...): niri would run with no
# output, i.e. a blank screen. Say so on the console instead. Only when the
# boot-time check said so (the GPU/3D path is untouched); re-checked live with
# `gpu-select --check` (sysfs only): a render-only device without outputs does
# not count, and a KMS GPU that bound after boot needs a reboot so that
# avalonos-gpu-select can point niri at it.
display_only=0
late_gpu=
if grep -qx 'AVALONOS_DISPLAY_ONLY=1' "$gpu_env" 2>/dev/null; then
    live="$("${AVALONOS_GPU_SELECT:-/usr/libexec/avalonos/gpu-select}" --check 2>/dev/null || echo display-only)"
    case "$live" in
        render) ;;
        "alt "*) display_only=1; late_gpu="${live#alt }" ;;
        *) display_only=1 ;;
    esac
fi

started="$(date +%s)"
rc=0
if [ "$display_only" = 1 ]; then
    rc=2
else
    systemctl --user --wait start niri.service || rc=$?
fi
if [ "$rc" -ne 0 ] && [ $(( $(date +%s) - started )) -lt 20 ]; then
    # Last resort only: niri failed even with kms_swrast, or cannot draw here.
    if [ -n "$late_gpu" ]; then
        msg="AvalonOS: a GPU ($late_gpu) appeared after boot; reboot so the desktop (niri) can render on it."
    elif [ "$display_only" = 1 ]; then
        msg="AvalonOS: this display adapter has no render device; the desktop (niri) cannot draw on it."
    else
        msg="AvalonOS: the desktop (niri) could not start on this display."
    fi
    printf '%s\n' "$msg" "$(grep '^#' "$gpu_env" 2>/dev/null | sed 's/^# //')" \
        | systemd-cat -t avalonos-session -p err 2>/dev/null || true
    {
        printf '\n  %s\n\n' "$msg"
        sed -n 's/^# /  GPU: /p' "$gpu_env" 2>/dev/null
        if [ "$display_only" = 1 ]; then
            printf '  In a VM, switch the display to a virtio GPU (QEMU: -vga virtio, or\n'
            printf '  virtio-vga-gl + gl=on; not -vga std/cirrus). Hyper-V and server BMC\n'
            printf '  video (no render device) cannot run the desktop.\n'
        else
            printf '  In a VM, enable 3D acceleration if you can (QEMU: virtio-vga-gl + gl=on;\n'
            printf '  VMware: Accelerate 3D graphics; VirtualBox: VMSVGA + Enable 3D).\n'
        fi
        printf '  Details: journalctl --user -u niri -b ; journalctl -t avalonos-session\n'
        printf '  A text console is on Ctrl+Alt+F2. Press Enter to return to the login screen.\n'
    } >&2
    read -r _ < /dev/tty 2>/dev/null || sleep 30
fi
systemctl --user start --job-mode=replace-irreversibly niri-shutdown.target >/dev/null 2>&1 || true
systemctl --user unset-environment WAYLAND_DISPLAY DISPLAY XDG_SESSION_TYPE XDG_CURRENT_DESKTOP NIRI_SOCKET >/dev/null 2>&1 || true
