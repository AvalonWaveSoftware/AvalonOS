[global]
    monitor = 0
    follow = mouse
    width = 320
    offset = 12x12
    padding = 8
    horizontal_padding = 10
    frame_width = 2
    frame_color = "#39FF14"
    separator_color = frame
    font = Noto Sans Mono 10
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    origin = top-right

[urgency_low]
    background = "#0A1628"
    foreground = "#D4FFD4"
    frame_color = "#1A3A5C"
    timeout = 6

[urgency_normal]
    background = "#0A1628"
    foreground = "#D4FFD4"
    frame_color = "#39FF14"
    timeout = 8

[urgency_critical]
    background = "#102445"
    foreground = "#D4FFD4"
    frame_color = "#C2185B"
    timeout = 0
