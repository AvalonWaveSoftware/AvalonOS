#!/usr/bin/env bash
# tailwhip: hash a user password (yescrypt) for the AvalonOS *test* seed.
#
# Since 2026-11-14 (decision 9:40 CT) the ISO carries no credential at all:
# root is locked and the daily user is created at first boot. tailwhip now
# only writes the test-harness seed. Only QA test builds read it (package
# avalonos-testseed, AVALONOS_TEST_BUILD=1; never on a release ISO), when the
# installed system boots with avalonos.testseed=1 and a disk labelled
# AVTESTSEED holds the file. It never sets or unlocks a root password.
#
#   tailwhip --user qa --out avalonos-seed.conf
#   tailwhip --user qa --password-env QA_PASSWORD --no-upgrade --out avalonos-seed.conf
#
# Passwords come from the named env var or a tty prompt, never from argv.
# The output (mode 0600) contains a hash: keep it on the test disk only.
set -euo pipefail
user=""; pw_env=""; out=""; upgrade=1
while [ $# -gt 0 ]; do
    case "$1" in
        --user) user="$2"; shift 2;;
        --password-env) pw_env="$2"; shift 2;;
        --out) out="$2"; shift 2;;
        --no-upgrade) upgrade=0; shift;;
        -h|--help) sed -n '2,15p' "$0"; exit 0;;
        *) echo "tailwhip: unknown argument $1" >&2; exit 2;;
    esac
done
[ -n "$user" ] && [ -n "$out" ] || { echo "usage: tailwhip --user NAME --out FILE [--password-env VAR] [--no-upgrade]" >&2; exit 2; }
case "$user" in [a-z_]*) ;; *) echo "tailwhip: bad user name" >&2; exit 2;; esac
case "$user" in *[!a-z0-9_-]*|root) echo "tailwhip: bad user name" >&2; exit 2;; esac
command -v mkpasswd >/dev/null || { echo "tailwhip: mkpasswd not found (dnf install mkpasswd)" >&2; exit 1; }
read_pw() {
    local v v2
    if [ -n "$pw_env" ]; then
        v="${!pw_env:-}"; [ -n "$v" ] || { echo "tailwhip: \$$pw_env is empty" >&2; exit 1; }
    else
        read -rsp "$user password: " v; echo >&2
        read -rsp "$user password (again): " v2; echo >&2
        [ "$v" = "$v2" ] && [ -n "$v" ] || { echo "tailwhip: passwords empty or do not match" >&2; exit 1; }
    fi
    printf '%s' "$v"
}
hash="$(read_pw | mkpasswd -m yescrypt --stdin)"
umask 077
printf '# AvalonOS test seed (tailwhip). TEST HARNESS ONLY.\nuser=%s\nhash=%s\nupgrade=%s\n' \
    "$user" "$hash" "$upgrade" > "$out"
chmod 0600 "$out"
echo "tailwhip: wrote $out (user $user; hash not shown)"
