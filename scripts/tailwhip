#!/usr/bin/env bash
# tailwhip: write kickstart/AvalonOS.local.ks (mode 0600, gitignored) from the
# tracked template, with a yescrypt password hash (ADR 0017).
#   scripts/tailwhip --user alice
#   scripts/tailwhip --user alice --password-env AVALONOS_PASSWORD
#   scripts/tailwhip --user alice --password-env AVALONOS_PASSWORD --root-password-env AVALONOS_ROOT_PASSWORD
# Passwords come from the named env var or a tty prompt, never from argv.
# Reconstructed in 2026-10 from ADR 0017; the original script was lost.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
user=admin; pw_env=; root_env=
while [ $# -gt 0 ]; do
    case "$1" in
        --user) user="$2"; shift 2;;
        --password-env) pw_env="$2"; shift 2;;
        --root-password-env) root_env="$2"; shift 2;;
        -h|--help) sed -n '2,9p' "$0"; exit 0;;
        *) echo "tailwhip: unknown argument $1" >&2; exit 2;;
    esac
done
command -v mkpasswd >/dev/null || { echo "tailwhip: mkpasswd not found (dnf install mkpasswd / apt install whois)" >&2; exit 1; }
hash_pw() { mkpasswd -m yescrypt --stdin; }
read_pw() { # label env
    local v
    if [ -n "$2" ]; then v="${!2:-}"; [ -n "$v" ] || { echo "tailwhip: \$$2 is empty" >&2; exit 1; }
    else
        local v2
        read -rsp "$1 password: " v; echo >&2
        read -rsp "$1 password (again): " v2; echo >&2
        [ "$v" = "$v2" ] && [ -n "$v" ] || { echo "tailwhip: passwords empty or do not match" >&2; exit 1; }
    fi
    printf '%s' "$v"
}
user_hash="$(read_pw "$user" "$pw_env" | hash_pw)"
if [ -n "$root_env" ]; then rootpw="rootpw --iscrypted $(read_pw root "$root_env" | hash_pw)"; else rootpw="rootpw --lock"; fi
"$ROOT/scripts/render-kickstart.sh" "$ROOT/kickstart/AvalonOS.local.ks" "$user" "$user_hash" "$rootpw"
echo "tailwhip: wrote kickstart/AvalonOS.local.ks (user $user, ${rootpw%% --iscrypted*}${root_env:+ --iscrypted})"
