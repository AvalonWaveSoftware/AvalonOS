# AvalonOS installer repo (P-M1r, decision 2026-11-14 11:30 CT). Shipped in
# /avalonos/updates.img (inst.updates= on every boot entry); replaces the
# installer's own file of this name. Anaconda installs from these system repos
# (closest-mirror source, no kickstart url). gpgcheck=1 + the pinned gpgkey:
# libdnf5 verifies every package's signature BEFORE the transaction (and any
# scriptlet) runs, and aborts the install otherwise.
# repo_gpgcheck=0: RPM Fusion publishes no signed metadata (repomd.xml.asc is
# HTTP 404, checked 2026-11-14), so repo_gpgcheck=1 cannot load. Metadata
# integrity: HTTPS metalink (repomd.xml checksums) + sslverify.
# RPM Fusion (ADR 0014); rpmfusion-*-release persist them on the installed system.

[rpmfusion-free]
name=RPM Fusion for Fedora 44 - Free
metalink=https://mirrors.rpmfusion.org/metalink?repo=free-fedora-44&arch=x86_64
enabled=1
type=rpm
gpgcheck=1
repo_gpgcheck=0
gpgkey=file:///etc/pki/avalonos-installer/RPM-GPG-KEY-rpmfusion-free-fedora-2020
sslverify=1
skip_if_unavailable=0

[rpmfusion-free-updates]
name=RPM Fusion for Fedora 44 - Free - Updates
metalink=https://mirrors.rpmfusion.org/metalink?repo=free-fedora-updates-released-44&arch=x86_64
enabled=1
type=rpm
gpgcheck=1
repo_gpgcheck=0
gpgkey=file:///etc/pki/avalonos-installer/RPM-GPG-KEY-rpmfusion-free-fedora-2020
sslverify=1
skip_if_unavailable=0

[rpmfusion-nonfree]
name=RPM Fusion for Fedora 44 - Nonfree
metalink=https://mirrors.rpmfusion.org/metalink?repo=nonfree-fedora-44&arch=x86_64
enabled=1
type=rpm
gpgcheck=1
repo_gpgcheck=0
gpgkey=file:///etc/pki/avalonos-installer/RPM-GPG-KEY-rpmfusion-nonfree-fedora-2020
sslverify=1
skip_if_unavailable=0

[rpmfusion-nonfree-updates]
name=RPM Fusion for Fedora 44 - Nonfree - Updates
metalink=https://mirrors.rpmfusion.org/metalink?repo=nonfree-fedora-updates-released-44&arch=x86_64
enabled=1
type=rpm
gpgcheck=1
repo_gpgcheck=0
gpgkey=file:///etc/pki/avalonos-installer/RPM-GPG-KEY-rpmfusion-nonfree-fedora-2020
sslverify=1
skip_if_unavailable=0
