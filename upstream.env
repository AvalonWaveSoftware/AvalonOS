# Upstream Fedora image AvalonOS remasters. Sourced by scripts/*.sh and CI.
FEDORA_RELEASE=44
UPSTREAM_ISO=Fedora-Everything-netinst-x86_64-44-1.7.iso
UPSTREAM_SIZE=1217329152
UPSTREAM_SHA256=bd285201494dd0ba09b54d05ac707de1401668b8512a573edb5922dcf9d7067e
UPSTREAM_CHECKSUM=Fedora-Everything-44-1.7-x86_64-CHECKSUM
# Tried in order. dl.fedoraproject.org is authoritative but often slow.
UPSTREAM_URLS="https://mirrors.kernel.org/fedora/releases/44/Everything/x86_64/iso https://dl.fedoraproject.org/pub/fedora/linux/releases/44/Everything/x86_64/iso https://mirrors.mit.edu/fedora/linux/releases/44/Everything/x86_64/iso"
# Fedora 44 primary key (keys/fedora-44.gpg, from https://fedoraproject.org/fedora.gpg).
FEDORA_KEY_FPR=36F612DCF27F7D1A48A835E4DBFCF71C6D9F90A6
# Volume ID is kept as Fedora's so inst.stage2=hd:LABEL=... keeps working.
VOLUME_ID=Fedora-E-dvd-x86_64-44
OUTPUT_ISO=AvalonOS-netinst-x86_64.iso
